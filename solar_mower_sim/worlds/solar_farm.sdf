<?xml version="1.0" ?>
<!--
  solar_farm.sdf : ソーラー発電所ワールド
  - 40 x 40 m の不整地 (heightmap)
  - パネル列 2 本 (x 方向 12 m, y = -2.42 と y = +2.42)。列の間の空きは 3.8 m = ロボット全幅 0.76 m の 5 倍
    (横梁の外面は列中心から ±0.52 m)。横梁は列の両面にあり、列の間からどちらの列も追従できる
  - 履帯草刈りロボット tracked_mower を列の間の中央・西端に配置 (前方 +x = 東)
  座標系: +x 東, +y 北
-->
<sdf version="1.9">
  <world name="solar_farm">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.70 0.82 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -0.8</direction>
    </light>

    <!-- 不整地 -->
    <include>
      <uri>model://solar_farm_terrain</uri>
      <name>terrain</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- パネル列 1 (南側) : 列の間に面した裏面横梁の外面は y = -1.90 -->
    <include>
      <uri>model://panel_row</uri>
      <name>panel_row_1</name>
      <pose>0 -2.42 0.12 0 0 0</pose>
    </include>

    <!-- パネル列 2 (北側) : 列の間に面した前面横梁の外面は y = +1.90 -->
    <include>
      <uri>model://panel_row</uri>
      <name>panel_row_2</name>
      <pose>0 2.42 0.12 0 0 0</pose>
    </include>

    <!-- 目印ポール: 列の間の中央 y=0 の西端 (赤) と東端 (緑) -->
    <model name="marker_start">
      <static>true</static>
      <pose>-7.5 0 0.8 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><cylinder><radius>0.05</radius><length>1.6</length></cylinder></geometry>
        <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
      </visual></link>
    </model>
    <model name="marker_goal">
      <static>true</static>
      <pose>7.5 0 0.8 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><cylinder><radius>0.05</radius><length>1.6</length></cylinder></geometry>
        <material><ambient>0.1 0.9 0.1 1</ambient><diffuse>0.1 0.9 0.1 1</diffuse></material>
      </visual></link>
    </model>

    <!-- 草刈りロボット: 列の間の中央 (両側の横梁まで各 1.9 m)、列の西端、前方 +x -->
    <include>
      <uri>model://tracked_mower</uri>
      <name>tracked_mower</name>
      <pose>-6 0 0.55 0 0 0</pose>
    </include>

  </world>
</sdf>
