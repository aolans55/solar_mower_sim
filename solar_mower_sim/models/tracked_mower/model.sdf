<?xml version="1.0" ?>
<!--
  tracked_mower : ソーラー発電所向け草刈りロボットのシミュレーションモデル
  - Gazebo Harmonic の TrackedVehicle / TrackController プラグインで履帯走行を再現
  - センサ: 2D LiDAR (前方上部), IMU (車体中心), オドメトリ (TrackedVehicle が出力)
  - 車体座標系: +x 前方, +y 左, +z 上
-->
<sdf version="1.9">
  <model name="tracked_mower">
    <pose>0 0 0.25 0 0 0</pose>

    <!-- ========== 車体 ========== -->
    <link name="base_link">
      <inertial>
        <mass>40.0</mass>
        <inertia>
          <ixx>1.5</ixx><iyy>3.0</iyy><izz>3.5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.80 0.42 0.22</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.80 0.42 0.22</size></box></geometry>
        <material>
          <ambient>0.85 0.45 0.05 1</ambient>
          <diffuse>0.95 0.55 0.10 1</diffuse>
        </material>
      </visual>
      <!-- 草刈り刃カバー (見た目のみ) -->
      <visual name="mower_deck_visual">
        <pose>0.45 0 -0.12 0 0 0</pose>
        <geometry><cylinder><radius>0.22</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>

      <!-- ===== IMU ===== -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <topic>imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- ===== LiDAR マスト ===== -->
    <link name="lidar_link">
      <!-- 架台の横梁を捉える高さ。LiDAR は地面 + 約 0.54 m (列の間の地面 0.02〜0.20 m → 0.56〜0.74 m)、
           横梁はワールドで 0.50〜0.80 m (gen_panel_row.py の BEAM_Z / BEAM_H) -->
      <pose>0.25 0 0.37 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- ========== 左右の履帯 ========== -->
    <!-- TrackController は「リンク全体が履帯」として接触面の速度を制御する -->
    <link name="left_track">
      <pose>0 0.30 -0.05 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia><ixx>0.05</ixx><iyy>0.6</iyy><izz>0.6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="left_track_collision">
        <geometry><box><size>0.90 0.16 0.20</size></box></geometry>
        <surface>
          <friction>
            <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
          </friction>
          <contact><ode><min_depth>0.005</min_depth><kp>1e6</kp><kd>100</kd></ode></contact>
        </surface>
      </collision>
      <visual name="left_track_visual">
        <geometry><box><size>0.90 0.16 0.20</size></box></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <!-- 転輪の見た目 -->
      <visual name="left_wheel_f"><pose>0.33 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.17</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      <visual name="left_wheel_r"><pose>-0.33 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.17</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
    </link>
    <joint name="left_track_joint" type="fixed">
      <parent>base_link</parent>
      <child>left_track</child>
    </joint>

    <link name="right_track">
      <pose>0 -0.30 -0.05 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia><ixx>0.05</ixx><iyy>0.6</iyy><izz>0.6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="right_track_collision">
        <geometry><box><size>0.90 0.16 0.20</size></box></geometry>
        <surface>
          <friction>
            <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
          </friction>
          <contact><ode><min_depth>0.005</min_depth><kp>1e6</kp><kd>100</kd></ode></contact>
        </surface>
      </collision>
      <visual name="right_track_visual">
        <geometry><box><size>0.90 0.16 0.20</size></box></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="right_wheel_f"><pose>0.33 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.17</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      <visual name="right_wheel_r"><pose>-0.33 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.17</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
    </link>
    <joint name="right_track_joint" type="fixed">
      <parent>base_link</parent>
      <child>right_track</child>
    </joint>

    <!-- ========== プラグイン ========== -->
    <!-- 各履帯リンクの接触面速度を制御 -->
    <plugin filename="gz-sim-track-controller-system"
            name="gz::sim::systems::TrackController">
      <link>left_track</link>
      <track_orientation>0 0 0</track_orientation>
      <max_command_age>0.5</max_command_age>
    </plugin>
    <plugin filename="gz-sim-track-controller-system"
            name="gz::sim::systems::TrackController">
      <link>right_track</link>
      <track_orientation>0 0 0</track_orientation>
      <max_command_age>0.5</max_command_age>
    </plugin>

    <!-- cmd_vel (Twist) → 左右履帯速度 変換 + オドメトリ出力 -->
    <plugin filename="gz-sim-tracked-vehicle-system"
            name="gz::sim::systems::TrackedVehicle">
      <left_track><link>left_track</link></left_track>
      <right_track><link>right_track</link></right_track>
      <tracks_separation>0.60</tracks_separation>
      <track_height>0.20</track_height>
      <steering_efficiency>0.5</steering_efficiency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <tf_topic>tf</tf_topic>
      <max_linear_velocity>1.5</max_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>
  </model>
</sdf>
