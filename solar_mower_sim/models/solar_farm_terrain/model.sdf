<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="solar_farm_terrain">
    <static>true</static>
    <link name="terrain_link">
      <collision name="terrain_collision">
        <geometry>
          <heightmap>
            <uri>model://solar_farm_terrain/heightmap.png</uri>
            <!-- x幅 y幅 最大高低差[m] -->
            <size>40 40 0.35</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="terrain_visual">
        <geometry>
          <heightmap>
            <uri>model://solar_farm_terrain/heightmap.png</uri>
            <size>40 40 0.35</size>
            <pos>0 0 0</pos>
            <texture>
              <diffuse>model://solar_farm_terrain/materials/textures/dirt_diffuse.png</diffuse>
              <normal>model://solar_farm_terrain/materials/textures/flat_normal.png</normal>
              <size>4</size>
            </texture>
            <texture>
              <diffuse>model://solar_farm_terrain/materials/textures/grass_diffuse.png</diffuse>
              <normal>model://solar_farm_terrain/materials/textures/flat_normal.png</normal>
              <size>4</size>
            </texture>
            <blend>
              <min_height>0.08</min_height>
              <fade_dist>0.10</fade_dist>
            </blend>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
